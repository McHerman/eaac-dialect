module attributes {
  dlti.target_system_spec = #dlti.target_system_spec<
    "EAAC" = #dlti.target_device_spec<
      "tier_capacities" = array<i64: 65536, 65536, 65536>,
      "alias_check_length" = 4096 : i64,
      "reuse_guard" = 100000 : i64,
      "num_semaphore_pairs" = 64 : i64,
      "num_semaphore_generations" = 4 : i64,
      "bus_size" = 64 : i64,
      "riscv_sem_base" = 32768 : i64
    >
  >
} {
  eaac.schedule @schedule {
    eaac.hw_alloc @unit0 : !eaac.gemm<2 32>
    eaac.hw_alloc @unit1 : !eaac.risc<1 32>
  }

  func.func private @matmul16x16(%lhs: tensor<16x16xi8>, %rhs: tensor<16x16xi8>) -> tensor<16x16xi32> {
    %c0_i32 = arith.constant 0 : i32
    %acc0 = tensor.empty() : tensor<16x16xi32>
    %acc = linalg.fill ins(%c0_i32 : i32) outs(%acc0 : tensor<16x16xi32>) -> tensor<16x16xi32>
    %mm = linalg.matmul ins(%lhs, %rhs : tensor<16x16xi8>, tensor<16x16xi8>) outs(%acc : tensor<16x16xi32>) -> tensor<16x16xi32>
    return %mm : tensor<16x16xi32>
  }

  func.func private @relu16x16(%in: tensor<16x16xi32>) -> tensor<16x16xi32> {
    %relu_out = tensor.empty() : tensor<16x16xi32>
    %relu = linalg.generic {indexing_maps = [affine_map<(d0, d1) -> (d0, d1)>, affine_map<(d0, d1) -> (d0, d1)>], iterator_types = ["parallel", "parallel"]} ins(%in : tensor<16x16xi32>) outs(%relu_out : tensor<16x16xi32>) {
    ^bb0(%xx: i32, %o: i32):
      %c0 = arith.constant 0 : i32
      %cond = arith.cmpi sgt, %xx, %c0 : i32
      %r = arith.select %cond, %xx, %c0 : i32
      linalg.yield %r : i32
    } -> tensor<16x16xi32>
    return %relu : tensor<16x16xi32>
  }

  func.func private @requantize16x16(%in: tensor<16x16xi32>) -> tensor<16x16xi8> {
    %quant_out = tensor.empty() : tensor<16x16xi8>
    %quant = linalg.generic {indexing_maps = [affine_map<(d0, d1) -> (d0, d1)>, affine_map<(d0, d1) -> (d0, d1)>], iterator_types = ["parallel", "parallel"]} ins(%in : tensor<16x16xi32>) outs(%quant_out : tensor<16x16xi8>) {
    ^bb0(%elem: i32, %out: i8):
      %M0 = arith.constant 1091133696 : i64
      %rsh = arith.constant 35 : i64
      %nudge = arith.constant 17179869184 : i64
      %zp = arith.constant -128 : i64
      %lo = arith.constant -128 : i64
      %hi = arith.constant 127 : i64
      %x64 = arith.extsi %elem : i32 to i64
      %prod = arith.muli %x64, %M0 : i64
      %rndd = arith.addi %prod, %nudge : i64
      %shft = arith.shrsi %rndd, %rsh : i64
      %bzp = arith.addi %shft, %zp : i64
      %locnd = arith.cmpi sgt, %bzp, %lo : i64
      %clo = arith.select %locnd, %bzp, %lo : i64
      %hicnd = arith.cmpi slt, %clo, %hi : i64
      %chi = arith.select %hicnd, %clo, %hi : i64
      %trunc = arith.trunci %chi : i64 to i8
      linalg.yield %trunc : i8
    } -> tensor<16x16xi8>
    return %quant : tensor<16x16xi8>
  }

  func.func private @kernel(%lhs: tensor<16x16xi8>, %rhs: tensor<16x16xi8>) -> tensor<16x16xi8> {
    %mm = func.call @matmul16x16(%lhs, %rhs) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi32>
    %relu = func.call @relu16x16(%mm) : (tensor<16x16xi32>) -> tensor<16x16xi32>
    %quant = func.call @requantize16x16(%relu) : (tensor<16x16xi32>) -> tensor<16x16xi8>
    return %quant : tensor<16x16xi8>
  }

  func.func @main(%arg0: tensor<16x16xi8>, %arg1: tensor<16x16xi8>) -> tensor<16x16xi8> {
    %v1 = arith.constant dense<""> : tensor<16x16xi8>
    %v2 = arith.constant dense<""> : tensor<16x16xi8>
    %v3 = arith.constant dense<""> : tensor<16x16xi8>
    %v4 = arith.constant dense<""> : tensor<16x16xi8>
    %v5 = arith.constant dense<""> : tensor<16x16xi8>
    %v6 = arith.constant dense<""> : tensor<16x16xi8>
    %v7 = arith.constant dense<""> : tensor<16x16xi8>
    %v8 = arith.constant dense<""> : tensor<16x16xi8>
    %v9 = arith.constant dense<""> : tensor<16x16xi8>

    %r1 = func.call @kernel(%arg0, %v1) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>

    %r2 = func.call @kernel(%r1, %v2) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r3 = func.call @kernel(%r1, %v3) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r4 = func.call @kernel(%r1, %v4) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r5 = func.call @kernel(%r1, %v5) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>

    %r6 = func.call @kernel(%r2, %v6) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r7 = func.call @kernel(%r3, %r5) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r8 = func.call @kernel(%r7, %v6) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>

    %r9  = func.call @kernel(%r8, %v2) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r10 = func.call @kernel(%r9, %v3) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r11 = func.call @kernel(%r10, %v4) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    %r12 = func.call @kernel(%r11, %v5) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    //%r13 = func.call @kernel(%r12, %v6) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    //%r13 = func.call @kernel(%r12, %v8) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    //%r14 = func.call @kernel(%r13, %v7) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>
    //%r15 = func.call @kernel(%r14, %v8) : (tensor<16x16xi8>, tensor<16x16xi8>) -> tensor<16x16xi8>

    return %r12: tensor<16x16xi8>
  }
}

// EAAC Program FlatBuffer Schema
// Serializes the final compiled IR into a binary format for runtime consumption.

namespace eaac_fb;

/// Element types for memref buffers.
enum ElementType : byte {
  I8 = 0,
  I16,
  I32,
  I64,
  F16,
  F32,
  F64
}

/// A constant tensor (weights, biases, etc.) embedded in the program.
table Constant {
  /// Name matching the memref.global symbol (e.g. "__constant_128x128xi8").
  name: string;
  /// Shape dimensions.
  shape: [uint32];
  /// Element type.
  element_type: ElementType;
  /// Raw data bytes (little-endian).
  data: [ubyte];
}

/// A reference to a statically allocated buffer.
table BufferRef {
  /// Static byte offset within its memory tier.
  offset: uint64;
  /// Memory tier (0=Local SRAM, 1=Global SRAM, 2=DRAM).
  tier: uint8;
  /// Shape dimensions (e.g. [128, 128]).
  shape: [uint32];
  /// Element type.
  element_type: ElementType;
  /// If set, this buffer's initial contents come from the named constant.
  constant_name: string;
}

/// Allocate and initialize a hardware semaphore pair.
table SemAlloc {
  /// Static hardware address (0–15).
  address: uint16;
  /// Initial empty count.
  empty_count: uint32;
  /// Initial full count.
  full_count: uint32;
  /// Anti-aliasing chains: other hardware semaphore addresses whose
  /// completion this allocation must wait for before initializing.
  /// Empty for ordinary allocations.
  chain_addresses: [uint16];
  /// Per-address generation tag. Successive SemAllocs on the same
  /// `address` advance this counter (wrapping at the DLTI-configured
  /// `num_semaphore_generations`), so the fabric can distinguish this
  /// allocation from earlier and later occupants of the same slot.
  generation: uint16;
}

/// Release a hardware semaphore pair.
table SemDealloc {
  /// Hardware address being released.
  address: uint16;
}

/// A semaphore dependency inside an execute block.
/// Pairs a semaphore address with a buffer reference.
table SemDep {
  /// Hardware semaphore address.
  sem_address: uint16;
  /// Index into the enclosing Function.buffers table.
  buffer_id: uint32;
  /// Anti-aliasing chains: other hardware semaphore addresses whose
  /// completion this dependency must wait for at initialization time.
  /// Empty for ordinary data dependencies.
  chain_addresses: [uint16];
  /// Generation tag of the SemAlloc this dependency targets. Lets the
  /// fabric reject stale signals from an earlier occupant of the slot.
  generation: uint16;
}

/// An asynchronous DMA transfer operation.
/// Operands are indices into Function.buffers.
table DmaStart {
  src: uint32;
  dst: uint32;
}

/// A load from host to accelerator, replaces function arguments.
/// Operand is an index into Function.buffers.
table LoadOp {
  dst: uint32;
}

// A store from accelerator to host, replaces function returns.
// Operand is an index into Function.buffers.
table StoreOp {
  src: uint32;
}

/// A matrix multiplication operation.
/// Operands are indices into Function.buffers.
table Matmul {
  src0: uint32;
  src1: uint32;
  dst: uint32;
}

/// The payload of an execute block.
union ExecutePayload { DmaStart, Matmul, LoadOp, StoreOp }

/// An execute block with semaphore acquire/require dependencies.
table Execute {
  /// Producer-side: semaphores to signal on completion.
  acquires: [SemDep];
  /// Consumer-side: semaphores to wait on before starting.
  requires: [SemDep];
  /// The operation to execute.
  payload: ExecutePayload;
}

/// A memory allocation. Operand is an index into Function.buffers.
table MemAlloc {
  buffer_id: uint32;
}

/// A memory deallocation. Operand is an index into Function.buffers.
table MemDealloc {
  buffer_id: uint32;
}

/// Top-level command — the operations appear in program order.
union Command { SemAlloc, SemDealloc, Execute, MemAlloc, MemDealloc }

table Operation {
  command: Command;
}

/// A function in the program.
table Function {
  name: string;

  /// Distinct buffers referenced by this function. Commands and SemDeps
  /// reference entries here by their index (buffer_id / src / dst / ...).
  buffers: [BufferRef];

  /// Operations in program order.
  ops: [Operation];
}

/// Top-level program container.
table Program {
  /// Functions in the module.
  functions: [Function];
  /// Maximum number of hardware semaphore pairs used.
  num_semaphores: uint16;
  /// Memory required per tier in bytes: index 0=Local SRAM, 1=Global SRAM, 2=DRAM.
  memory_per_tier: [uint64];
  /// Constant tensors (weights, biases) referenced by BufferRef.constant_name.
  constants: [Constant];
}

root_type Program;

file_identifier "EAAC";
file_extension "eaac";
